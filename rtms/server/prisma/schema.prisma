datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id           String   @id @default(uuid())
  name         String
  username     String   @unique
  passwordHash String
  role         String
  status       String   @default("active")
  lastActiveAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preparedTransactions Transaction[] @relation("PreparedBy")
  reviewedTransactions Transaction[] @relation("ReviewedBy")
  auditLogs            AuditLog[]
}

model Student {
  id            String   @id @default(uuid())
  studentNumber String   @unique
  lastName      String
  firstName     String
  middleName    String?
  email         String?
  sex           String?
  contactNumber String?
  course        String
  yearLevel     Int
  active        Boolean  @default(true)
  isAlumni      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions Transaction[]

  @@index([lastName])
  @@index([studentNumber])
}

model Transaction {
  id               String    @id @default(uuid())
  studentId        String
  student          Student   @relation(fields: [studentId], references: [id])
  studentName      String
  studentCourse    String
  studentYearLevel Int
  docCOR           Int       @default(0)
  docCOG           Int       @default(0)
  docGMC           Int       @default(0)
  docAUTH          Int       @default(0)
  docOTR           Int       @default(0)
  others           String    @default("")
  othersCount      Int       @default(0)
  status           String    @default("Pending")
  preparedBy       String
  preparedByUser   User      @relation("PreparedBy", fields: [preparedBy], references: [id])
  preparedByName   String
  preparedAt       DateTime
  reviewedBy       String?
  reviewedByUser   User?     @relation("ReviewedBy", fields: [reviewedBy], references: [id])
  reviewedByName   String?
  reviewedAt       DateTime?
  duration         Int?
  releasedTo       String?
  signature        String?
  releasedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  auditLogs AuditLog[]
  signingSessions SigningSession[]

  @@index([status])
  @@index([preparedBy])
  @@index([preparedAt])
}

model AuditLog {
  id              String      @id @default(uuid())
  transactionId   String
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  action          String
  previousStatus  String?
  newStatus       String
  performedBy     String
  performedByUser User        @relation(fields: [performedBy], references: [id])
  performedByName String
  timestamp       DateTime    @default(now())

  @@index([transactionId])
  @@index([timestamp(sort: Desc)])
}

model SigningSession {
  id            String   @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  // All transactions released under this session (bulk release).
  // transactionId holds the first one.
  transactionIds String[] @default([])

  token         String   @unique
  releasedTo    String
  liveSignature String?
  status        String   @default("pending")
  consentAt     DateTime?
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([transactionId])
  @@index([status])
}

// Single row: the one device allowed to use the tablet sign page.
model TabletLock {
  id         String   @id @default("tablet")
  deviceId   String
  lastSeenAt DateTime
}